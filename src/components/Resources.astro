---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import { SITE, withBase } from "../config/site";
import { getReleaseInfo, releaseHasExamples } from "../lib/releases";

const release = await getReleaseInfo();
const useExamples = releaseHasExamples(release);

const resources = useExamples
  ? [
      {
        title: "Quick start",
        description: "Install a release and run quickstart.py.",
        href: "#quick-start",
        external: false,
      },
      {
        title: "Commercial demo",
        description: "8,790-heliostat Daggett reference case.",
        href: "#commercial-demo",
        external: false,
      },
      {
        title: "Execution backends",
        description: "CPU, multicore and CUDA.",
        href: SITE.docs.backend,
        external: true,
      },
      {
        title: "Benchmarks & reproducibility",
        description: "Timing boundaries and measured evidence.",
        href: SITE.docs.reproducibility,
        external: true,
      },
    ]
  : [
      {
        title: "Installation & packaging",
        description: "Release archives and runtime requirements.",
        href: SITE.docs.installation,
        external: true,
      },
      {
        title: "Execution backends",
        description: "CPU, multicore and CUDA.",
        href: SITE.docs.backend,
        external: true,
      },
      {
        title: "Benchmarks & reproducibility",
        description: "Timing boundaries and measured evidence.",
        href: SITE.docs.reproducibility,
        external: true,
      },
      {
        title: "Examples",
        description: "A synthetic optical simulation.",
        href: SITE.docs.examples,
        external: true,
      },
    ];
---

<section id="resources" class="site-container py-20 md:py-28">
  <SectionHeader
    label="Documentation"
    title={useExamples
      ? "Examples, backends and evidence."
      : "Guides, benchmarks and evidence."}
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
    {
      resources.map((resource) => (
        <a
          href={resource.href}
          target={resource.external ? "_blank" : undefined}
          rel={resource.external ? "noopener noreferrer" : undefined}
          class="group border-t border-line pt-5 transition-colors hover:border-accent"
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-base font-medium tracking-[-0.02em] text-ink transition-colors group-hover:text-accent">
              {resource.title}
            </h3>
            <Icon
              name={resource.external ? "arrow-up-right" : "arrow-right"}
              size={14}
              class="mt-0.5 shrink-0 text-muted transition-colors group-hover:text-accent"
            />
          </div>
          <p class="mt-2 max-w-[16rem] text-sm leading-relaxed text-muted">
            {resource.description}
          </p>
          {resource.external && (
            <span class="sr-only">(opens in a new tab)</span>
          )}
        </a>
      ))
    }
  </div>

  <div class="mt-10">
    <a
      href={withBase("/docs/")}
      class="group inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors hover:text-accent"
    >
      Documentation index
      <Icon
        name="arrow-right"
        size={15}
        class="transition-transform group-hover:translate-x-0.5"
      />
    </a>
  </div>
</section>
