---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import { SITE, withBase } from "../config/site";

const resources = [
  {
    title: "Execution modes",
    description: "Select CPU, multicore or CUDA execution.",
    href: withBase("/docs/execution-modes/"),
    external: false,
  },
  {
    title: "Build from source",
    description: "Toolchains, dependencies and native builds.",
    href: SITE.docs.build,
    external: true,
  },
  {
    title: "Benchmarks & evidence",
    description: "Annual measurements and timing boundaries.",
    href: SITE.docs.benchmarkEvidence,
    external: true,
  },
  {
    title: "Documentation",
    description: "Installation, API usage and technical guides.",
    href: withBase("/docs/"),
    external: false,
  },
];
---

<section id="resources" class="site-container py-20 md:py-28">
  <SectionHeader
    label="Documentation"
    title="Practical guides and evidence."
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
    {
      resources.map((resource) => (
        <a
          href={resource.href}
          target={resource.external ? "_blank" : undefined}
          rel={resource.external ? "noopener noreferrer" : undefined}
          class="group border-t border-line pt-5 transition-colors hover:border-accent"
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-base font-medium tracking-[-0.02em] text-ink transition-colors group-hover:text-accent">
              {resource.title}
            </h3>
            <Icon
              name={resource.external ? "arrow-up-right" : "arrow-right"}
              size={14}
              class="mt-0.5 shrink-0 text-muted transition-colors group-hover:text-accent"
            />
          </div>
          <p class="mt-2 max-w-[16rem] text-sm leading-relaxed text-muted">
            {resource.description}
          </p>
          {resource.external && (
            <span class="sr-only">(opens in a new tab)</span>
          )}
        </a>
      ))
    }
  </div>

</section>
