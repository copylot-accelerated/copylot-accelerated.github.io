---
import CodeBlockWithCopy from "./CodeBlockWithCopy.astro";
import Icon from "./Icon.astro";
import { SITE, withBase } from "../config/site";
import {
  getReleaseInfo,
  releaseHasExamples,
  type ReleaseInfo,
} from "../lib/releases";
import {
  examplesInstallCommands,
  legacyInstallCommands,
} from "../data/quickstart";

interface Props {
  release?: ReleaseInfo;
}

const { release } = Astro.props;
const currentRelease = release ?? (await getReleaseInfo());
const useExamples = releaseHasExamples(currentRelease);
const commands = useExamples ? examplesInstallCommands : legacyInstallCommands;
---

<section id="install" class="site-container py-12 md:py-16">
  <div class="border-t border-line pt-6">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 lg:col-span-4">
        <p class="eyebrow">Install</p>
        <h2
          class="mt-3 text-[clamp(1.9rem,3.5vw,2.6rem)] leading-[1.02] tracking-[-0.04em]"
        >
          Install and verify
        </h2>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
          {
            useExamples
              ? "Extract the archive and run quickstart.py. Python 3.12 is recommended."
              : "Extract the archive and run the included example. Python 3.12 is recommended."
          }
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a href={withBase("/downloads/#packages")} class="btn btn-primary">
            <Icon name="download" size={16} />
            Choose a package
          </a>
          <a
            class="link-underline text-xs"
            href={SITE.docs.build}
            target="_blank"
            rel="noopener noreferrer">Advanced: Build from source ↗</a
          >
        </div>
      </div>

      <div class="min-w-0 lg:col-span-8">
        <p class="eyebrow">Linux / macOS</p>
        <CodeBlockWithCopy
          code={commands.linux}
          label="Linux / macOS"
          class="mt-2"
        />

        <p class="eyebrow mt-4">Windows PowerShell</p>
        <CodeBlockWithCopy
          code={commands.windows}
          label="Windows PowerShell"
          class="mt-2"
        />

        <p class="mt-4 text-xs leading-relaxed text-muted">
          Verify with
          <code class="code-inline">sha256sum -c SHA256SUMS.txt</code> on Linux or
          <code class="code-inline">shasum -a 256 -c SHA256SUMS.txt</code> on
          macOS. On Windows, use
          <code class="code-inline">Get-FileHash</code>.
        </p>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          For CPU, multicore or CUDA selection, see the
          <a class="link-underline" href={withBase("/docs/execution-modes/")}
            >Execution modes guide</a
          >.
        </p>
      </div>
    </div>
  </div>
</section>
