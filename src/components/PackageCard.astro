---
import Icon from "./Icon.astro";
import { formatBytes, type PackageDownload } from "../lib/releases";

interface Props {
  entry: PackageDownload;
  checksumUrl: string | null;
}

const { entry, checksumUrl } = Astro.props;
const { spec, asset } = entry;
---

<article class="grid gap-5 py-6 md:grid-cols-12 md:items-start md:gap-6">
  <div class="border-l-2 border-accent pl-4 md:col-span-3">
    <h3 class="text-[17px] font-semibold tracking-[-0.02em] text-ink">
      {spec.platform}
      <span class="font-normal text-muted">{spec.architecture}</span>
    </h3>
    <span
      class:list={["badge mt-2", spec.backend === "CUDA" && "badge-accent"]}
    >
      {spec.backend}
    </span>
  </div>

  <div class="min-w-0 md:col-span-6">
    {
      asset ? (
        <>
          <p class="break-all font-mono text-[11px] leading-relaxed text-ink-soft">
            {asset.name}
          </p>
          <div class="mt-2 flex items-start gap-x-4 text-[11px] text-muted">
            <span class="shrink-0">{formatBytes(asset.sizeBytes)}</span>
            {asset.sha256 ? (
              <details class="group min-w-0 flex-1">
                <summary
                  class="inline-flex cursor-pointer list-none items-center gap-1 whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.08em] text-muted transition-colors hover:text-ink"
                >
                  SHA-256
                  <Icon
                    name="chevron-down"
                    size={10}
                    class="transition-transform group-open:rotate-180"
                  />
                </summary>
                <div class="mt-2">
                  <button
                    type="button"
                    class="checksum-code inline-block max-w-full"
                    data-checksum-copy={asset.sha256}
                    data-checksum-copy-tooltip
                    data-tooltip="Copy SHA-256"
                    aria-label="Copy SHA-256 checksum"
                  >
                    <code class="break-all">{asset.sha256}</code>
                    <span
                      class="checksum-check is-hidden text-accent"
                      data-checksum-check
                      aria-hidden="true"
                    >
                      <Icon name="check" size={13} />
                    </span>
                  </button>
                  <span
                    class="sr-only"
                    data-checksum-copy-status
                    aria-live="polite"
                  ></span>
                </div>
              </details>
            ) : checksumUrl ? (
              <a
                class="link-underline font-mono text-[10px] uppercase tracking-[0.08em]"
                href={checksumUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                SHA256SUMS.txt
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            ) : (
              <span>Not published</span>
            )}
          </div>
        </>
      ) : (
        <p class="text-sm text-muted">Not included in this release.</p>
      )
    }
  </div>

  <div class="flex items-center md:col-span-3 md:justify-end">
    {
      asset ? (
        <a
          href={asset.downloadUrl}
          class="btn btn-secondary w-full md:w-auto"
          aria-label={`Download the ${spec.platform} ${spec.architecture} ${spec.backend} package`}
        >
          <Icon name="download" size={15} />
          Download
        </a>
      ) : (
        <span class="text-xs text-muted">Unavailable</span>
      )
    }
  </div>
</article>

<style>
  .checksum-code {
    background: transparent;
    border: 0;
    color: var(--ink-soft);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.625;
    max-width: 100%;
    padding: 0 1.35rem 0 0;
    position: relative;
    text-align: left;
    transition: color 150ms ease;
  }

  .checksum-code:hover {
    color: var(--ink);
  }

  .checksum-code::after {
    background: var(--ink);
    border-radius: 2px;
    color: var(--paper);
    content: attr(data-tooltip);
    font-family: var(--font-mono);
    font-size: 10px;
    left: 0;
    line-height: 1.2;
    opacity: 0;
    padding: 5px 7px;
    pointer-events: none;
    position: absolute;
    top: calc(100% + 6px);
    transition: opacity 120ms ease;
    white-space: nowrap;
    z-index: 10;
  }

  .checksum-code:hover::after,
  .checksum-code:focus-visible::after {
    opacity: 1;
  }

  .checksum-check {
    bottom: 0.1em;
    display: inline-flex;
    position: absolute;
    right: 0;
  }

  .checksum-check.is-hidden {
    display: none;
  }
</style>
