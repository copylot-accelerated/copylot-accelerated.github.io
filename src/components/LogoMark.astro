---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "", size = 22 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="12"
    cy="12"
    r="7.4"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-dasharray="38 8.5"
  ></circle>
  <path
    d="M19.4 4.6 14.4 9.6"
    stroke="var(--accent)"
    stroke-width="1.6"
    stroke-linecap="round"
  ></path>
  <circle cx="12" cy="12" r="2.1" fill="var(--accent)"></circle>
</svg>
