---
import SectionHeader from "./SectionHeader.astro";
import { SITE, withBase } from "../config/site";

const modes = [
  {
    title: "Original",
    meta: "Reference",
    body: "Retained SolarPILOT/CoPylot CPU paths on one thread.",
  },
  {
    title: "Refactored CPU",
    meta: "Single-thread",
    body: "Optimized image-plane and flux calculation.",
  },
  {
    title: "Multicore CPU",
    meta: "Parallel",
    body: "Parallel work within and across independent states.",
  },
  {
    title: "CUDA GPU",
    meta: "Linux · SM 89",
    body: "Double-precision GPU evaluation with CPU preparation.",
  },
];
---

<section id="modes" class="site-container py-20 md:py-28">
  <SectionHeader
    label="Execution modes"
    title="Choose the path that fits the hardware."
    lead="Same Hermite formulation and CoPylot API across all modes. CUDA is Linux x86-64 only."
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
    {
      modes.map((mode) => (
        <article class="border-t border-line pt-5">
          <p class="eyebrow">{mode.meta}</p>
          <h3 class="mt-4 text-base font-medium tracking-[-0.02em] text-ink">
            {mode.title}
          </h3>
          <p class="mt-2 max-w-[15rem] text-sm leading-relaxed text-muted">
            {mode.body}
          </p>
        </article>
      ))
    }
  </div>

  <div class="mt-10 flex flex-wrap gap-x-5 gap-y-2 text-xs">
    <a
      class="link-underline"
      href={SITE.docs.backend}
      target="_blank"
      rel="noopener noreferrer">Backend guide ↗</a
    >
    <a class="link-underline" href={withBase("/downloads/#requirements")}
      >Runtime requirements</a
    >
  </div>
</section>
