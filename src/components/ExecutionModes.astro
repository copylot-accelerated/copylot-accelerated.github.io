---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import { withBase } from "../config/site";

const modes = [
  {
    title: "Original",
    meta: "Reference",
    body: "Original SolarPILOT/CoPylot CPU implementation.",
  },
  {
    title: "Refactored CPU",
    meta: "Single-thread",
    body: "Optimized image-plane and flux calculation.",
  },
  {
    title: "Multicore CPU",
    meta: "Parallel",
    body: "Parallel work within and across independent states.",
  },
  {
    title: "CUDA GPU",
    meta: "Linux · SM 89",
    body: "Double-precision GPU evaluation with CPU preparation.",
  },
];
---

<section id="modes" class="site-container py-20 md:py-28">
  <SectionHeader
    label="Execution modes"
    title="Choose the execution mode that fits your hardware."
    lead="Same Hermite formulation and CoPylot API across all modes."
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
    {
      modes.map((mode) => (
        <article class="border-t border-line pt-5">
          <p class="eyebrow">{mode.meta}</p>
          <h3 class="mt-4 text-base font-medium tracking-[-0.02em] text-ink">
            {mode.title}
          </h3>
          <p class="mt-2 max-w-[15rem] text-sm leading-relaxed text-muted">
            {mode.body}
          </p>
        </article>
      ))
    }
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
    <a
      class="link-underline inline-flex items-center gap-1 font-medium"
      href={withBase("/docs/execution-modes/")}
    >
      How to select an execution mode
      <Icon name="arrow-right" size={12} />
    </a>
    <a class="link-underline" href={withBase("/downloads/#requirements")}
      >Runtime requirements</a
    >
  </div>
</section>
