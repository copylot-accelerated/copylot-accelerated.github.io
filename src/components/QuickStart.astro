---
import CodeBlockWithCopy from "./CodeBlockWithCopy.astro";
import Icon from "./Icon.astro";
import { SITE, withBase } from "../config/site";
import { getReleaseInfo, releaseHasExamples } from "../lib/releases";
import {
  examplesInstallCommands,
  legacyInstallCommands,
  quickStartExpectedOutput,
  quickStartNote,
} from "../data/quickstart";

const release = await getReleaseInfo();
const useExamples = releaseHasExamples(release);
const commands = useExamples ? examplesInstallCommands : legacyInstallCommands;
---

<section
  id="quick-start"
  class="site-container scroll-mt-24 py-20 md:py-28"
>
  <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow">Quick start</p>
      <h2
        class="mt-4 text-[clamp(2.1rem,4.5vw,3.6rem)] leading-[1.02] tracking-[-0.045em]"
      >
        From archive to simulation.
      </h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted">
        {
          useExamples
            ? "Download an archive, install its requirements and run quickstart.py. Python 3.12 is recommended."
            : "Download an archive, install its requirements and run the example. Python 3.12 is recommended."
        }
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
        <a href={withBase("/downloads/")} class="btn btn-primary">
          <Icon name="download" size={16} />
          Download packages
        </a>
        <a
          class="link-underline text-xs"
          href={SITE.docs.build}
          target="_blank"
          rel="noopener noreferrer">Advanced: Build from source ↗</a
        >
      </div>
    </div>

    <div class="min-w-0 lg:col-span-7">
      <p class="eyebrow">Linux / macOS</p>
      <CodeBlockWithCopy
        code={commands.linux}
        label="Linux / macOS"
        class="mt-2"
      />

      <p class="eyebrow mt-5">Windows PowerShell</p>
      <CodeBlockWithCopy
        code={commands.windows}
        label="Windows PowerShell"
        class="mt-2"
      />

      {
        useExamples && (
          <div class="mt-5">
            <p class="eyebrow">Expected output</p>
            <pre
              class="mt-2 whitespace-pre-wrap border border-line bg-paper-sunken p-4 font-mono text-[11px] leading-relaxed text-ink-soft"
            >{quickStartExpectedOutput}</pre>
            <p class="mt-3 text-xs leading-relaxed text-muted">
              {quickStartNote}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
