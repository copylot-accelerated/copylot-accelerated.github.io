---
import { SITE } from "../config/site";
---

<section id="quick-start" class="site-container py-20 md:py-28">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow">Quick start</p>
      <h2
        class="mt-4 text-[clamp(2.1rem,4.5vw,3.6rem)] leading-[1.02] tracking-[-0.045em]"
      >
        From archive to simulation.
      </h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted">
        Download an archive, install its requirements and run the example.
        Python 3.12 is recommended.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs">
        <a
          class="link-underline"
          href={SITE.docs.installation}
          target="_blank"
          rel="noopener noreferrer">Installation guide ↗</a
        >
        <a
          class="link-underline"
          href={SITE.docs.build}
          target="_blank"
          rel="noopener noreferrer">Build from source ↗</a
        >
      </div>
    </div>

    <div class="min-w-0 lg:col-span-7">
      <p class="eyebrow">Linux / macOS</p>
      <pre class="code-block mt-2"><code>python3.12 -m venv .venv
.venv/bin/python -m pip install -r requirements.txt
.venv/bin/python example.py --mode refactored</code></pre>

      <p class="eyebrow mt-5">Windows PowerShell</p>
      <pre class="code-block mt-2"><code>py -3.12 -m venv .venv
.\.venv\Scripts\python.exe -m pip install -r requirements.txt
.\.venv\Scripts\python.exe example.py --mode refactored</code></pre>
    </div>
  </div>
</section>
