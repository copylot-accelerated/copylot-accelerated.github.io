---
import Icon from "./Icon.astro";
import PackageCard from "./PackageCard.astro";
import { SITE } from "../config/site";
import { formatReleaseDate, type ReleaseInfo } from "../lib/releases";

interface Props {
  release: ReleaseInfo;
}

const { release } = Astro.props;
const selected = release.selected;
const isPrerelease = release.status === "prerelease";
const isUnavailable = release.status === "unavailable";
const checksumUrl = selected?.checksumAsset?.downloadUrl ?? null;

const emptyHeading = isUnavailable
  ? "Downloads are temporarily unavailable."
  : "Public downloads will appear here.";

const emptyBody = isUnavailable
  ? "Please check GitHub Releases for the latest published packages."
  : "Packages are distributed through GitHub Releases.";
---

<section class="site-container pt-10 pb-20 md:pt-12 md:pb-24">
  {
    selected ? (
      <>
        <div class="border-y border-line py-7 sm:py-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
            <div>
              <p class="eyebrow eyebrow-accent">
                {isPrerelease ? "Latest prerelease" : "Latest stable release"}
              </p>
              <h2 class="mt-3 text-3xl font-medium tracking-[-0.045em] sm:text-4xl">
                {selected.tagName}
              </h2>
              <p class="mt-2 text-xs text-muted">
                Published {formatReleaseDate(selected.publishedAt)}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <a
                href={selected.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary"
              >
                Release notes
                <Icon name="arrow-up-right" size={14} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
              {selected.checksumAsset && (
                <a
                  href={selected.checksumAsset.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  SHA256SUMS.txt
                  <Icon name="download" size={14} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="mt-8 divide-y divide-line border-y border-line">
          {release.packages.map((entry) => (
            <PackageCard entry={entry} checksumUrl={checksumUrl} />
          ))}
        </div>

        <div class="mt-8 text-xs">
          <a
            class="link-underline"
            href={SITE.docs.build}
            target="_blank"
            rel="noopener noreferrer">Build from source ↗</a
          >
        </div>

        {release.recent.length > 1 && (
          <div class="mt-12 border-t border-line pt-6">
            <p class="eyebrow">Release history</p>
            <ul class="mt-4 divide-y divide-line border-y border-line">
              {release.recent.map((item) => (
                <li class="flex flex-wrap items-center gap-x-4 gap-y-1 py-3">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-ink transition-colors hover:text-accent"
                  >
                    {item.tagName}
                  </a>
                  <span class="text-[11px] text-muted">
                    {formatReleaseDate(item.publishedAt)}
                  </span>
                  {item.prerelease && <span class="badge">Prerelease</span>}
                  <span class="ml-auto font-mono text-[10px] text-muted">
                    {item.assetCount} {item.assetCount === 1 ? "asset" : "assets"}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    ) : (
      <div class="border-y border-line py-14 text-center sm:py-16">
        <div class="mx-auto flex h-11 w-11 items-center justify-center border border-line">
          <Icon
            name={isUnavailable ? "alert-circle" : "package"}
            size={20}
            class="text-accent"
          />
        </div>
        <h2 class="mx-auto mt-6 max-w-2xl text-3xl font-medium tracking-[-0.045em] sm:text-4xl">
          {emptyHeading}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted">
          {emptyBody}
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a
            href={SITE.repository.releases}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            GitHub Releases
            <Icon name="arrow-up-right" size={14} />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
          <a
            href={SITE.docs.installation}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost">Installation guide ↗</a
          >
        </div>
      </div>

      <div class="mt-12 border-t border-line pt-8">
        <p class="eyebrow">Supported platforms</p>
        <div class="mt-5 divide-y divide-line border-y border-line">
          {SITE.packages.map((spec) => (
            <div class="flex items-center justify-between gap-4 py-3.5">
              <span class="text-sm font-semibold text-ink">
                {spec.platform}
                <span class="ml-1 font-normal text-muted">
                  {spec.architecture}
                </span>
              </span>
              <span
                class:list={[
                  "badge",
                  spec.backend === "CUDA" && "badge-accent",
                ]}
              >
                {spec.backend}
              </span>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-muted">
          CUDA is Linux x86-64 only and requires an SM 89 GPU. Windows and macOS
          packages are CPU-only. <a
            class="link-underline"
            href={SITE.docs.build}
            target="_blank"
            rel="noopener noreferrer">Build from source ↗</a
          >
        </p>
      </div>
    )
  }
</section>
