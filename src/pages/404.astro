---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../config/site";
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found."
  path="/404/"
  noindex
>
  <section class="site-container py-24 text-center md:py-32">
    <p class="eyebrow">404</p>
    <h1
      class="mx-auto mt-4 max-w-2xl text-[clamp(2.8rem,7vw,5.2rem)] leading-[0.98] tracking-[-0.05em]"
    >
      Page not found.
    </h1>
    <p class="mx-auto mt-5 max-w-md text-sm leading-relaxed text-muted sm:text-base">
      The page may have moved, or the address may be incomplete.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={withBase("/")} class="btn btn-primary">
        <Icon name="arrow-right" size={16} />
        Back to home
      </a>
      <a href={withBase("/docs/")} class="btn btn-secondary">
        <Icon name="book-open" size={16} />
        Documentation
      </a>
      <a href={withBase("/downloads/")} class="btn btn-secondary">
        <Icon name="download" size={16} />
        Downloads
      </a>
    </div>
  </section>
</BaseLayout>
