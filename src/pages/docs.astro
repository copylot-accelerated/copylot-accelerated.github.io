---
import BaseLayout from "../layouts/BaseLayout.astro";
import CitationBlock from "../components/CitationBlock.astro";
import DocLink from "../components/DocLink.astro";
import Icon from "../components/Icon.astro";
import { SITE, withBase } from "../config/site";
import { getReleaseInfo, releaseHasExamples } from "../lib/releases";

const release = await getReleaseInfo();
const useExamples = releaseHasExamples(release);

const startLinks = useExamples
  ? [
      {
        title: "Downloads & installation",
        description:
          "Release archives, runtime requirements and verification.",
        href: withBase("/downloads/"),
      },
      {
        title: "Quick start",
        description: "Install a release and run quickstart.py.",
        href: withBase("/#quick-start"),
      },
      {
        title: "Commercial demo",
        description:
          "8,790-heliostat Daggett reference case and offline report.",
        href: withBase("/#commercial-demo"),
      },
    ]
  : [
      {
        title: "Downloads & installation",
        description:
          "Release archives, runtime requirements and verification.",
        href: withBase("/downloads/"),
      },
      {
        title: "Overview and quick start",
        description: "Project overview and the packaged example.",
        href: SITE.docs.readme,
      },
      {
        title: "Examples",
        description: "The packaged synthetic example and source-tree simulation.",
        href: SITE.docs.examples,
      },
    ];

const apiExampleHref = useExamples
  ? SITE.docs.quickstartSource
  : SITE.docs.packagedExample;
const apiExampleDescription = useExamples
  ? "Complete quickstart.py: create, configure, simulate and free a context."
  : "The packaged example: configure a field and run a simulation.";

const groups = [
  {
    id: "start",
    title: "Getting started",
    links: startLinks,
  },
  {
    id: "using",
    title: "Using CoPylot-Accelerated",
    links: [
      {
        title: "Execution modes",
        description:
          "Choose CPU, multicore or CUDA execution with practical examples.",
        href: withBase("/docs/execution-modes/"),
      },
      {
        title: "Python API example",
        description: apiExampleDescription,
        href: apiExampleHref,
      },
      {
        title: "Backend compatibility",
        description:
          "Supported CPU and CUDA configurations, with technical limitations.",
        href: SITE.docs.backend,
      },
    ],
  },
  {
    id: "validation",
    title: "Performance & validation",
    links: [
      {
        title: "Benchmarks and numerical validation",
        description:
          "Measurement methodology, timing boundaries and numerical checks.",
        href: SITE.docs.benchmarkEvidence,
      },
      {
        title: "Reproducibility",
        description: "Validate a build or run new measurements.",
        href: SITE.docs.reproducibility,
      },
      {
        title: "Annual benchmark matrix (CSV)",
        description:
          "Raw dataset: eight complete annual campaigns across two cases.",
        href: SITE.docs.annualMatrix,
      },
      {
        title: "Annual benchmark matrix (JSON)",
        description: "Raw dataset: the same annual measurements as JSON.",
        href: SITE.docs.annualMatrixJson,
      },
      {
        title: "Measured toolchain (JSON)",
        description: "Raw dataset: measured hardware, compiler and libraries.",
        href: SITE.docs.measuredToolchain,
      },
    ],
  },
  {
    id: "development",
    title: "Development & internals",
    links: [
      {
        title: "Build from source",
        description: "Toolchains, dependency reconstruction and native tests.",
        href: SITE.docs.build,
      },
      {
        title: "Multicore implementation",
        description:
          "Threading design and deterministic work partitioning.",
        href: SITE.docs.multicore,
      },
      {
        title: "CUDA implementation",
        description: "Hybrid image-plane and flux-density design.",
        href: SITE.docs.cudaHandoff,
      },
      {
        title: "CUDA validation record",
        description:
          "Flat-receiver numerical comparison and tested restrictions.",
        href: SITE.docs.cudaValidation,
      },
      {
        title: "Dependencies",
        description: "Pinned upstream components and native libraries.",
        href: SITE.docs.dependencies,
      },
      {
        title: "Packaging and platform status",
        description:
          "Archive layout, platform validation and CUDA targets.",
        href: SITE.docs.packaging,
      },
    ],
  },
  {
    id: "project",
    title: "Project & licensing",
    links: [
      {
        title: "Citation and references",
        description:
          "Software citation and the SolarPILOT and CoPylot papers.",
        href: "#citation",
      },
      {
        title: "Project license",
        description: "MIT terms for eligible original project code.",
        href: SITE.docs.license,
      },
      {
        title: "Third-party notices",
        description: "Upstream terms and binary distribution conditions.",
        href: SITE.docs.notices,
      },
    ],
  },
] as const;
---

<BaseLayout
  title="Documentation"
  description="Guides, benchmarks, citation and licensing for CoPylot-Accelerated and the SolarPILOT/CoPylot optical stack."
  path="/docs/"
  active="docs"
>
  <section class="border-b border-line">
    <div class="site-container py-16 text-center md:py-20 lg:py-24">
      <p class="eyebrow">Technical reference</p>
      <h1
        class="mt-4 text-[clamp(2.8rem,6vw,4.7rem)] leading-[0.98] tracking-[-0.05em]"
      >
        Documentation
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
        Installation, practical usage, benchmark evidence and licensing.
      </p>
      {
        useExamples && (
          <div class="mx-auto mt-5 flex max-w-3xl flex-col items-center gap-2 sm:flex-row sm:justify-center sm:gap-3">
            <p class="eyebrow shrink-0">Suggested path</p>
            <nav
              class="flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-sm"
              aria-label="Suggested documentation path"
            >
                <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
                  <a
                    class="link-underline font-medium"
                    href={withBase("/#quick-start")}
                  >
                    Quick start
                  </a>
                  <Icon
                    name="arrow-right"
                    size={15}
                    class="shrink-0 text-muted"
                  />
                </span>
                <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
                  <a
                    class="link-underline font-medium"
                    href={withBase("/#commercial-demo")}
                  >
                    Commercial demo
                  </a>
                  <Icon
                    name="arrow-right"
                    size={15}
                    class="shrink-0 text-muted"
                  />
                </span>
                <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
                  <a
                    class="link-underline font-medium"
                    href={withBase("/docs/execution-modes/")}
                  >
                    Execution modes
                  </a>
                  <Icon
                    name="arrow-right"
                    size={15}
                    class="shrink-0 text-muted"
                  />
                </span>
                <a
                  class="link-underline whitespace-nowrap font-medium"
                  href="#validation"
                >
                  Benchmarks and validation
                </a>
              </nav>
            </div>
          )
      }
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="docs-layout grid gap-12 lg:grid-cols-12 lg:gap-12">
      <aside class="hidden lg:col-span-3 lg:block">
        <nav class="sticky top-24" aria-label="Documentation sections">
          <p class="eyebrow">Contents</p>
          <ul class="mt-4 space-y-3 border-l border-line pl-4">
            {
              groups.map((group) => (
                <li>
                  <a
                    href={`#${group.id}`}
                    class="text-sm text-muted transition-colors hover:text-ink"
                  >
                    {group.title}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="#citation"
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                Citation
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <div class="lg:col-span-9">
        <nav
          class="mb-10 flex flex-wrap gap-x-5 gap-y-2 border-y border-line py-3 text-xs lg:hidden"
          aria-label="Documentation sections"
        >
          {
            groups.map((group) => (
              <a class="link-underline" href={`#${group.id}`}>
                {group.title}
              </a>
            ))
          }
          <a class="link-underline" href="#citation">Citation</a>
        </nav>

        <div class="space-y-14">
          {
            groups.map((group) => (
              <section id={group.id} class="scroll-mt-24">
                <h2 class="pb-4 text-2xl font-medium tracking-[-0.035em]">
                  {group.title}
                </h2>
                <div class="mt-2">
                  {group.links.map((link) => (
                    <DocLink {...link} />
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <CitationBlock />
      </div>
    </div>
  </section>
</BaseLayout>
